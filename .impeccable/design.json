      "html": "<label class=\"ds-label\" for=\"ds-answer\">Arrival time</label><input class=\"ds-input\" id=\"ds-answer\" aria-describedby=\"ds-hint\"/><span class=\"ds-hint\" id=\"ds-hint\">Use HH:MM</span>",
      "css": ".ds-label{display:block;color:var(--text);font:21px \"VT323\",monospace;margin-bottom:8px}.ds-input{display:block;width:240px;min-height:52px;background:#102b2f;color:var(--text);border:2px solid #6a9a86;border-bottom:4px solid #9dbd9f;border-radius:0;box-shadow:inset 3px 3px #0d1b24;padding:8px 12px;font:26px/1 \"VT323\",monospace;letter-spacing:.035em;caret-color:var(--gold)}.ds-input:hover{border-color:var(--sage)}.ds-input:focus-visible{outline:3px solid var(--gold);outline-offset:4px}.ds-input[aria-invalid=\"true\"]{border-color:var(--danger)}.ds-hint{display:block;margin-top:8px;font:17px/1.2 \"VT323\",monospace;color:var(--muted)}"
